%% Swells — system architecture
%% Keep in step with CLAUDE.md and bun-service/CLAUDE.md.

flowchart TD
    %% ---------- Clients ----------
    User["Surfer<br/>7 locations, one slug route each"]
    UI["SurfAppClient.tsx<br/>Renders AI prose only — no numeric stat row<br/>TanStack Query: staleTime 30m, no polling<br/>refetch on window focus"]
    SW["public/sw.js<br/>Offline cache + push/notificationclick<br/>PWA install prompt"]

    %% ---------- Next.js on Vercel ----------
    subgraph Vercel["Next.js app (Vercel)"]
        ReportAPI["/api/surf-report<br/>Cache-first: serve DB row if &lt; 8h old"]
        SurfAPI["/api/surfability<br/>Live conditions + surfability score<br/>STRICT: 503 if any source fails"]
        AdminAPI["/api/admin/request-forecast<br/>Clears cache, asks Bun to pre-generate"]
        SaveAPI["/api/admin/save-report<br/>Receives generated reports"]
        PushLib["lib/push.ts<br/>Evaluates subscriber thresholds, sends web-push"]
        WaveSize["lib/waveSize.ts<br/>Hs → face height → body-scale descriptor"]
        Locations["lib/locations.ts<br/>coastFacingDeg, noaaStationId,<br/>waveHeightCalibration per spot"]
    end

    %% ---------- Bun service ----------
    subgraph BunSvc["bun-service/ — source in this repo, deployed separately on Coolify"]
        BunGen["POST /generate-surf-report<br/>Prompt gets body-scale 'Surf Size', never feet"]
        Ladder{"Model ladder"}
        Haiku["Claude Haiku<br/>primary"]
        GPT["GPT-4o-mini<br/>secondary"]
        BunTmpl["Deterministic template<br/>bun-fallback"]
        Validate["validateReportText()<br/>banned openers · word count ·<br/>wind ground-truth contradiction"]
    end

    %% ---------- External ----------
    subgraph Sources["External data sources"]
        OMMarine["Open-Meteo Marine<br/>wave height (Hs), period,<br/>swell direction, sea temp"]
        OMWeather["Open-Meteo Weather<br/>wind, air temp, weather code"]
        NOAATides["NOAA Tides &amp; Currents<br/>per-location station"]
        NDBC["NDBC buoys<br/>offline only — source of the<br/>calibration factors,<br/>never called at runtime"]
    end

    NeonDB[("Neon PostgreSQL<br/>surf_reports · location_requests<br/>push_subscriptions")]
    Cron["GitHub Actions cron<br/>4x daily, all locations"]

    %% ---------- Flow ----------
    User --> UI
    UI --> SW
    UI --> ReportAPI
    ReportAPI -->|"cache hit &lt; 8h"| NeonDB
    ReportAPI -->|"cache miss"| SurfAPI
    ReportAPI -->|"cache miss"| BunGen
    ReportAPI -.->|"Bun unreachable →<br/>Next.js local template"| NeonDB

    SurfAPI --> OMMarine
    SurfAPI --> OMWeather
    SurfAPI --> NOAATides
    SurfAPI --> Locations
    SurfAPI --> WaveSize
    NDBC -.->|"fitted offline"| Locations

    BunGen --> Ladder
    Ladder --> Haiku
    Haiku --> Validate
    Validate -->|"rejected"| GPT
    GPT --> Validate
    Validate -->|"both tiers failed"| BunTmpl
    BunGen --> SaveAPI
    SaveAPI --> NeonDB

    Cron --> AdminAPI
    AdminAPI --> BunGen
    SaveAPI --> PushLib
    PushLib --> SW

    %% ---------- Styling ----------
    classDef userStyle fill:#34495e,stroke:#2c3e50,stroke-width:2px,color:#fff
    classDef uiStyle fill:#e74c3c,stroke:#c0392b,stroke-width:2px,color:#fff
    classDef apiStyle fill:#2ecc71,stroke:#27ae60,stroke-width:2px,color:#fff
    classDef bunStyle fill:#16a085,stroke:#0e6655,stroke-width:2px,color:#fff
    classDef externalStyle fill:#3498db,stroke:#2980b9,stroke-width:2px,color:#fff
    classDef databaseStyle fill:#9b59b6,stroke:#8e44ad,stroke-width:2px,color:#fff
    classDef cronStyle fill:#f39c12,stroke:#e67e22,stroke-width:2px,color:#fff

    class User userStyle
    class UI,SW uiStyle
    class ReportAPI,SurfAPI,AdminAPI,SaveAPI,PushLib,WaveSize,Locations apiStyle
    class BunGen,Ladder,Haiku,GPT,BunTmpl,Validate bunStyle
    class OMMarine,OMWeather,NOAATides,NDBC externalStyle
    class NeonDB databaseStyle
    class Cron cronStyle
